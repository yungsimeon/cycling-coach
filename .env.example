# Copy to .env.local and fill in. Values for local dev come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: the "anon key" / "publishable key" printed by `supabase status`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, never prefix with NEXT_PUBLIC_ (added once we build the AI features)
# ANTHROPIC_API_KEY=
